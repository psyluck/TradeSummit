# Cloudflare Pages cache headers (free-tier edge optimization).
#
# Only content-hashed files under /assets/ may be immutable. styles.css and
# main.js ship under stable filenames, so they must revalidate; index.html
# points at them with a ?v= cache-buster because an earlier deploy advertised
# the unhashed names as immutable for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/styles.css
  Cache-Control: no-cache

/main.js
  Cache-Control: no-cache

/
  Cache-Control: no-store

/index.html
  Cache-Control: no-store

/legal.html
  Cache-Control: no-store

/*.html
  Cache-Control: no-store
